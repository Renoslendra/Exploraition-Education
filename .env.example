# =============================================================================
# MODULIN — Environment Variables Template
# =============================================================================
# Salin variabel ini ke Vercel Project Settings > Environment Variables

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Gemini AI (dari Google AI Studio — https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# NextAuth (Auth.js) Configuration
AUTH_SECRET=generate_32_chars_random_secret_here
AUTH_GOOGLE_ID=your_google_oauth_client_id_here
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret_here

# Kredensial Demo Supabase (Untuk Demo / Juri)
NEXT_PUBLIC_DEMO_EMAIL=guru.demo@modulin.id
NEXT_PUBLIC_DEMO_PASSWORD=PasswordModulin2026!
